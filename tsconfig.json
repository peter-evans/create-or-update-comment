{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "lib": [
      "es2022",
      "dom"
    ],
    "outDir": "./lib",
    "rootDir": "./src",
    "declaration": true,
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "moduleResolution": "bundler"
  },
  "exclude": ["__test__", "lib", "node_modules"]
}
